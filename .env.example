# Web Push (optional). The app works fully without these.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: expose the public key to the Vite client at build time.
# If unset, the client reads it from GET /api/subscribe.
VITE_VAPID_PUBLIC_KEY=

# Upstash Redis REST (former Vercel KV shape). Required for durable
# production subscriptions. Without these, /api/subscribe writes a
# local file (.data/subscriptions.json) which is ephemeral on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Optional override for the file fallback path (local/dev only).
# SUBS_FILE=.data/subscriptions.json
